# Copy this file to ".env" (without the ".example") and fill in your key.
# The .env should NEVER be committed to GitHub — add it to .gitignore.

GOOGLE_MAPS_API_KEY=your_key_here
PORT=3000

# Password protection (optional, but recommended). If you leave
# APP_PASSWORD empty/commented out, the app is accessible without login
# to anyone with the address — useful only for quick tests on localhost.
APP_PASSWORD=choose_a_strong_password

# Used to sign the session cookie. Any long random string works (e.g.
# generate one with `openssl rand -hex 32`). If you don't set this, the
# app still works, but generates a new one on every startup — meaning
# every login expires whenever you restart the server.
SESSION_SECRET=a_long_random_string_here

# AI engine (Claude vision) for "Video → Address" (optional). Without
# this set, the app still works, just with only the "local" (tesseract,
# offline) engine available — the "AI" engine stays grayed out/unavailable
# in the selector.
ANTHROPIC_API_KEY=sk-ant-your_key_here
# Optional, defaults to claude-sonnet-5. You can switch to a cheaper
# model (e.g. claude-haiku-4-5-20251001) if you process a lot of videos.
ANTHROPIC_MODEL=claude-sonnet-5

# How long (in days) the address/distance cache stays valid before it's
# willing to pay Google again for the same request. Nothing is actively
# deleted — this just decides whether an already-stored value is trusted
# when it's requested again. Defaults: addresses 365 days (rarely change
# location), distances 90 days (may change with new roads/roadworks).
GEOCODE_CACHE_TTL_DAYS=365
DISTANCE_CACHE_TTL_DAYS=90

# Optional: the address other devices should use to reach this server
# when scanning a "share via QR code" link (see the README section on
# this feature). By default, if you load the app via "localhost", the
# server tries to guess your machine's LAN IP automatically. Set this
# to skip guessing entirely — useful if the automatic guess picks the
# wrong network interface, which can happen on a VM with more than one
# virtual network adapter (e.g. a NAT adapter plus a bridged/LAN one).
# Format: IP-or-hostname:port, e.g.:
# SHARE_HOST=192.168.1.50:3000

# Which geocoding source to use (address text -> coordinates):
#   auto      (default) swisstopo first (free, Swiss addresses), Google
#             as fallback for everything else. Best balance.
#   swisstopo swisstopo only — costs nothing, but ONLY resolves Swiss
#             addresses; anything else simply won't be found.
#   google    Google only — widest coverage and best at fixing typos,
#             but every lookup is billable, including Swiss ones.
# Note: this only affects address lookups (address text -> coordinates).
# Route distances/times are controlled separately by ROUTING_SOURCE below.
GEOCODING_SOURCE=auto

# Where route distances/times come from:
#   google (default) Google Distance Matrix — live traffic, costs money
#   osrm             your own self-hosted OSRM server — free, unlimited,
#                    but no live traffic (see README for how to set up)
# If OSRM is unreachable, the app automatically falls back to Google so
# you're never blocked; watch the server log to confirm OSRM is really
# being used while testing.
ROUTING_SOURCE=google

# Base URL of your OSRM instance (only used when ROUTING_SOURCE=osrm).
OSRM_URL=http://localhost:5000

# One OSRM instance serves ONE travel profile (baked in at pre-process
# time). If you also run a walking-profile instance, point this at it;
# otherwise walking legs keep using Google.
# OSRM_URL_WALKING=http://localhost:5001

# Base URL of a self-hosted Valhalla instance (see README: "Map +
# dynamic road exclusion"). Separate from ROUTING_SOURCE/OSRM_URL above —
# only used by the "🗺️ Mapa" section and the "🚧 Excluir troço" feature,
# never by the address-list optimization itself. Leave unset to keep the
# map section hidden; there's no fallback for this one.
# VALHALLA_URL=http://localhost:8002
